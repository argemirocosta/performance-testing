          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;nome&quot;: &quot;JMeter Admin&quot;, &quot;email&quot;: &quot;${adminEmail}&quot;, &quot;password&quot;: &quot;jmeter@perf&quot;, &quot;administrador&quot;: &quot;true&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp>
