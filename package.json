{
  "name": "performance-testing",
  "version": "1.0.0",
  "description": "Performance tests with k6 (TypeScript) and JMeter against the ServeRest API, with metrics in Prometheus and dashboards in Grafana",
  "private": true,
  "type": "module",
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "k6:smoke": "sh scripts/run-k6.sh smoke",
    "k6:load": "sh scripts/run-k6.sh load",
    "k6:stress": "sh scripts/run-k6.sh stress",
    "k6:spike": "sh scripts/run-k6.sh spike",
    "k6:soak": "sh scripts/run-k6.sh soak",
    "jmeter:smoke": "sh scripts/run-jmeter.sh smoke",
    "jmeter:load": "sh scripts/run-jmeter.sh load",
    "jmeter:gui": "jmeter -q jmeter/user.properties -t jmeter/serverest.jmx",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "k6",
    "jmeter",
    "performance-testing",
    "load-testing",
    "typescript",
    "prometheus",
    "grafana"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/k6": "^2.3.1",
    "typescript": "^7.0.2"
  }
}
