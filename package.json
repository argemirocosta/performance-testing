{
  "name": "k6-performance-testing",
  "version": "1.0.0",
  "description": "Performance tests with k6 and TypeScript against the ServeRest API, with metrics in Prometheus and dashboards in Grafana",
  "private": true,
  "type": "module",
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "test:smoke": "sh scripts/run-test.sh smoke",
    "test:load": "sh scripts/run-test.sh load",
    "test:stress": "sh scripts/run-test.sh stress",
    "test:spike": "sh scripts/run-test.sh spike",
    "test:soak": "sh scripts/run-test.sh soak",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "k6",
    "performance-testing",
    "load-testing",
    "typescript",
    "prometheus",
    "grafana"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/k6": "^2.3.1",
    "typescript": "^7.0.2"
  }
}
